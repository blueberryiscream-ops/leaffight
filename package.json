{
  "name": "leaffight",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-core-isolation.mjs && tsc && vite build",
    "preview": "vite preview",
    "data:bundle": "node scripts/build-data-bundle.mjs",
    "test:core-priority": "node --import ./scripts/register-ts-loader.mjs scripts/test-core-priority.ts",
    "test:timing": "node --import ./scripts/register-ts-loader.mjs scripts/test-timing.ts",
    "test:play-declare": "node --import ./scripts/register-ts-loader.mjs scripts/test-play-declare.ts",
    "test:battle": "node --import ./scripts/register-ts-loader.mjs scripts/test-battle.ts",
    "test:battle-flow": "node --import ./scripts/register-ts-loader.mjs scripts/test-battle-flow.ts",
    "test:battle-values": "node --import ./scripts/register-ts-loader.mjs scripts/test-battle-values.ts",
    "test:deck": "node --import ./scripts/register-ts-loader.mjs scripts/test-deck.ts",
    "test:setup": "node --import ./scripts/register-ts-loader.mjs scripts/test-setup.ts",
    "test": "npm run test:core-priority && npm run test:timing && npm run test:play-declare && npm run test:battle && npm run test:battle-flow && npm run test:battle-values && npm run test:deck && npm run test:setup",
    "verify": "npm run build && npm run test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "dexie": "^4.0.11",
    "fflate": "^0.8.2",
    "peerjs": "^1.5.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.2"
  }
}
